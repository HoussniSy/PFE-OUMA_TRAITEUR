{% extends 'base.html.twig' %}

{% block title %}{{ user.fullName }} - Détails{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            {# Card profil #}
            <div class="card">
                <div class="card-body text-center">
                    <img src="{{ user.avatarPath }}"
                         alt="{{ user.fullName }}"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150"
                         style="object-fit: cover;">

                    <h4>{{ user.fullName }}</h4>

                    {% if user.poste %}
                        <p class="text-muted">{{ user.poste }}</p>
                    {% endif %}

                    <div class="mb-3">
                        {{ user.roleBadge|raw }}
                        {% if user.isActive %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-secondary">Inactif</span>
                        {% endif %}
                    </div>

                    <div class="d-grid gap-2">
                        <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-primary">
                            <i class="bi bi-pencil-fill"></i> Modifier
                        </a>
                        <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>

            {# Informations système #}
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informations système</h6>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tr>
                            <td class="text-muted">Créé le</td>
                            <td class="text-end">{{ user.createdAt|date('d/m/Y à H:i') }}</td>
                        </tr>
                        {% if user.lastLoginAt %}
                            <tr>
                                <td class="text-muted">Dernière connexion</td>
                                <td class="text-end">{{ user.lastLoginAt|date('d/m/Y à H:i') }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td class="text-muted">Email vérifié</td>
                            <td class="text-end">
                                {% if user.isVerified %}
                                    <span class="badge bg-success">Oui</span>
                                {% else %}
                                    <span class="badge bg-warning">Non</span>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            {# Informations de contact #}
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-person-vcard"></i> Informations de contact</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Nom complet</label>
                            <p class="mb-0"><strong>{{ user.fullName }}</strong></p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Email</label>
                            <p class="mb-0">
                                <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Téléphone</label>
                            <p class="mb-0">
                                {% if user.phone %}
                                    <a href="tel:{{ user.phone }}">{{ user.phone }}</a>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Poste / Fonction</label>
                            <p class="mb-0">{{ user.poste ?? '-' }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Historique d'audit #}
            {% if auditLogs|length > 0 %}
                <div class="card mt-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Historique des modifications</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Action</th>
                                        <th>Effectué par</th>
                                        <th>Détails</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for log in auditLogs %}
                                        <tr>
                                            <td>{{ log.createdAt|date('d/m/Y H:i') }}</td>
                                            <td>{{ log.actionBadge|raw }}</td>
                                            <td>{{ log.performedBy ? log.performedBy.fullName : 'Système' }}</td>
                                            <td>
                                                <small class="text-muted">{{ log.description }}</small>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card mt-3">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <p class="text-muted mt-2">Aucun historique disponible pour cet utilisateur.</p>
                    </div>
                </div>
            {% endif %}

            {# Actions rapides #}
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-lightning-fill"></i> Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <form method="post"
                                  action="{{ path('app_user_toggle_status', {id: user.id}) }}"
                                  onsubmit="return confirm('{{ user.isActive ? 'Désactiver' : 'Activer' }} ce compte ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                <button type="submit" class="btn btn-outline-{{ user.isActive ? 'warning' : 'success' }} w-100">
                                    <i class="bi bi-{{ user.isActive ? 'pause-circle' : 'play-circle' }}-fill"></i>
                                    {{ user.isActive ? 'Désactiver' : 'Activer' }}
                                </button>
                            </form>
                        </div>
                        <div class="col-md-4">
                            <form method="post"
                                  action="{{ path('app_user_reset_password', {id: user.id}) }}"
                                  onsubmit="return confirm('Réinitialiser le mot de passe ? Un email sera envoyé.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('reset' ~ user.id) }}">
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-key-fill"></i> Reset mot de passe
                                </button>
                            </form>
                        </div>
                        <div class="col-md-4">
                            <form method="post"
                                  action="{{ path('app_user_delete', {id: user.id}) }}"
                                  onsubmit="return confirm('ATTENTION : Supprimer {{ user.fullName }} définitivement ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-trash-fill"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
