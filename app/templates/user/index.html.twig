{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0"><i class="bi bi-people-fill"></i> Gestion des utilisateurs</h1>
            <p class="text-muted">Administration des comptes utilisateurs</p>
        </div>
        <a href="{{ path('app_user_new') }}" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Nouvel utilisateur
        </a>
    </div>

    {# Statistiques #}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total utilisateurs</h6>
                            <h2 class="mb-0">{{ totalUsers }}</h2>
                        </div>
                        <div class="text-primary" style="font-size: 3rem;">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Comptes actifs</h6>
                            <h2 class="mb-0">{{ activeUsers }}</h2>
                        </div>
                        <div class="text-success" style="font-size: 3rem;">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Administrateurs</h6>
                            <h2 class="mb-0">{{ adminUsers }}</h2>
                        </div>
                        <div class="text-danger" style="font-size: 3rem;">
                            <i class="bi bi-shield-fill-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Filtres et recherche #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label for="search" class="form-label">Recherche</label>
                    <input type="text"
                           class="form-control"
                           id="search"
                           name="search"
                           value="{{ search }}"
                           placeholder="Nom, prénom ou email...">
                </div>
                <div class="col-md-3">
                    <label for="role" class="form-label">Rôle</label>
                    <select class="form-control" id="role" name="role">
                        <option value="all" {% if roleFilter == 'all' %}selected{% endif %}>Tous les rôles</option>
                        <option value="ROLE_ADMIN" {% if roleFilter == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur</option>
                        <option value="ROLE_COMPTABLE" {% if roleFilter == 'ROLE_COMPTABLE' %}selected{% endif %}>Comptable</option>
                        <option value="ROLE_USER" {% if roleFilter == 'ROLE_USER' %}selected{% endif %}>Utilisateur</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="status" class="form-label">Statut</label>
                    <select class="form-control" id="status" name="status">
                        <option value="all" {% if statusFilter == 'all' %}selected{% endif %}>Tous</option>
                        <option value="active" {% if statusFilter == 'active' %}selected{% endif %}>Actifs</option>
                        <option value="inactive" {% if statusFilter == 'inactive' %}selected{% endif %}>Inactifs</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Tableau des utilisateurs #}
    <div class="card">
        <div class="card-header bg-white">
            <h5 class="mb-0">Liste des utilisateurs ({{ users|length }})</h5>
        </div>
        <div class="card-body p-0">
            {% if users|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Avatar</th>
                                <th>Nom complet</th>
                                <th>Email</th>
                                <th>Téléphone</th>
                                <th>Rôle</th>
                                <th>Statut</th>
                                <th>Créé le</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>
                                        <img src="{{ user.avatarPath }}"
                                             alt="{{ user.fullName }}"
                                             class="rounded-circle"
                                             width="40"
                                             height="40"
                                             style="object-fit: cover;">
                                    </td>
                                    <td>
                                        <strong>{{ user.fullName }}</strong>
                                        {% if user.poste %}
                                            <br><small class="text-muted">{{ user.poste }}</small>
                                        {% endif %}
                                    </td>
                                    <td>{{ user.email }}</td>
                                    <td>{{ user.phone ?? '-' }}</td>
                                    <td>{{ user.roleBadge|raw }}</td>
                                    <td>
                                        {% if user.isActive %}
                                            <span class="badge bg-success">Actif</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactif</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ user.createdAt|date('d/m/Y') }}</td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_user_show', {id: user.id}) }}"
                                               class="btn btn-sm btn-outline-info"
                                               title="Voir détails">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('app_user_edit', {id: user.id}) }}"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            {# Toggle statut #}
                                            <form method="post"
                                                  action="{{ path('app_user_toggle_status', {id: user.id}) }}"
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir {{ user.isActive ? 'désactiver' : 'activer' }} ce compte ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-{{ user.isActive ? 'warning' : 'success' }}"
                                                        title="{{ user.isActive ? 'Désactiver' : 'Activer' }}">
                                                    <i class="bi bi-{{ user.isActive ? 'pause-circle' : 'play-circle' }}"></i>
                                                </button>
                                            </form>

                                            {# Réinitialiser mot de passe #}
                                            <form method="post"
                                                  action="{{ path('app_user_reset_password', {id: user.id}) }}"
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Réinitialiser le mot de passe de {{ user.fullName }} ? Un nouvel email sera envoyé.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('reset' ~ user.id) }}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Réinitialiser mot de passe">
                                                    <i class="bi bi-key"></i>
                                                </button>
                                            </form>

                                            {# Supprimer #}
                                            <form method="post"
                                                  action="{{ path('app_user_delete', {id: user.id}) }}"
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ user.fullName }} ? Cette action est irréversible.');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">Aucun utilisateur trouvé.</p>
                    <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Créer le premier utilisateur
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

    {# Journal d'audit #}
    {% if recentAuditLogs|length > 0 %}
        <div class="card mt-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Journal d'audit (10 dernières actions)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Admin</th>
                                <th>Action</th>
                                <th>Utilisateur cible</th>
                                <th>Détails</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in recentAuditLogs %}
                                <tr>
                                    <td>{{ log.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>{{ log.performedBy ? log.performedBy.fullName : 'Système' }}</td>
                                    <td>{{ log.actionBadge|raw }}</td>
                                    <td>{{ log.targetUserEmail }}</td>
                                    <td>
                                        <small class="text-muted">{{ log.description }}</small>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
