{% extends 'base.html.twig' %}

{% block title %}Rapports - Ouma Traiteur{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col-12 col-md-6">
            <h1><i class="bi bi-bar-chart"></i> Rapports</h1>
            <p class="text-muted">Statistiques et analyses</p>
        </div>
        <div class="col-12 col-md-6">
            <form method="get" class="d-flex justify-content-md-end gap-2">
                <select name="year" class="form-select" style="max-width: 200px;">
                    {% for y in range(year - 3, year + 1) %}
                        <option value="{{ y }}" {{ y == year ? 'selected' }}>{{ y }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat"></i> Actualiser
                </button>
                <a href="{{ path('app_reports_export_excel', {year: year}) }}" class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Exporter
                </a>
            </form>
        </div>
    </div>

    {# Statistiques générales #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-primary">
                <div class="card-body">
                    <h6 class="text-muted mb-2">CA Annuel</h6>
                    <h3 class="mb-0 text-primary">{{ yearlyRevenue|number_format(0, ',', ' ') }}</h3>
                    <small class="text-muted">MRU</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Nb Factures</h6>
                    <h3 class="mb-0 text-success">{{ totalInvoices }}</h3>
                    <small class="text-muted">factures</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Taux Conversion</h6>
                    <h3 class="mb-0 text-info">{{ conversionRate|number_format(1) }}%</h3>
                    <small class="text-muted">devis → factures</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-warning">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Panier Moyen</h6>
                    <h3 class="mb-0 text-warning">{{ averageBasket|number_format(0, ',', ' ') }}</h3>
                    <small class="text-muted">MRU</small>
                </div>
            </div>
        </div>
    </div>

    {# Graphique ventes mensuelles #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-graph-up"></i> Ventes mensuelles {{ year }}
                    </h5>
                    <canvas id="salesChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        {# Top clients #}
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-trophy"></i> Top 10 Clients
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Client</th>
                                    <th class="text-end">CA</th>
                                    <th class="text-center">Docs</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for client in topClients %}
                                    <tr>
                                        <td>
                                            {% if loop.index <= 3 %}
                                                <i class="bi bi-award-fill text-warning"></i>
                                            {% else %}
                                                {{ loop.index }}
                                            {% endif %}
                                        </td>
                                        <td>{{ client.name }}</td>
                                        <td class="text-end">
                                            <strong>{{ client.totalRevenue|number_format(0, ',', ' ') }}</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">{{ client.documentCount }}</span>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">
                                            Aucune donnée disponible
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        {# Top services #}
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-star"></i> Top 10 Services
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Service</th>
                                    <th class="text-end">CA</th>
                                    <th class="text-center">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for service in topServices %}
                                    <tr>
                                        <td>
                                            {% if loop.index <= 3 %}
                                                <i class="bi bi-star-fill text-warning"></i>
                                            {% else %}
                                                {{ loop.index }}
                                            {% endif %}
                                        </td>
                                        <td>{{ service.designation }}</td>
                                        <td class="text-end">
                                            <strong>{{ service.totalAmount|number_format(0, ',', ' ') }}</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">{{ service.count }}</span>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">
                                            Aucune donnée disponible
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Données des ventes mensuelles
    const salesData = {{ monthlySales|json_encode|raw }};

    // Préparer les données pour le graphique
    const months = ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun', 'Jul', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'];
    const data = new Array(12).fill(0);
    const counts = new Array(12).fill(0);

    salesData.forEach(item => {
        const monthIndex = parseInt(item.month) - 1;
        data[monthIndex] = parseFloat(item.revenue);
        counts[monthIndex] = parseInt(item.count);
    });

    // Créer le graphique
    const ctx = document.getElementById('salesChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: months,
            datasets: [{
                label: 'Chiffre d\'affaires (MRU)',
                data: data,
                backgroundColor: 'rgba(0, 166, 81, 0.7)',
                borderColor: '#00a651',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const value = context.parsed.y.toLocaleString('fr-FR');
                            const count = counts[context.dataIndex];
                            return [
                                'CA: ' + value + ' MRU',
                                'Factures: ' + count
                            ];
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString('fr-FR');
                        }
                    }
                }
            }
        }
    });
</script>
{% endblock %}
