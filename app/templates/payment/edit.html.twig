{% extends 'base.html.twig' %}

{% block title %}Modifier le paiement{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Modifier le paiement</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form) }}
                            {{ form_row(form.datePaiement) }}
                            {{ form_row(form.montant) }}
                            {{ form_row(form.modePaiement) }}
                            {{ form_row(form.statutPaiement) }}
                            {{ form_row(form.reference) }}
                            {{ form_row(form.notes) }}

                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Enregistrer
                                </button>
                                <a href="{{ path('app_payment_index', {'id': payment.document.id}) }}" class="btn btn-secondary">
                                    <i class="bi bi-x"></i> Annuler
                                </a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
