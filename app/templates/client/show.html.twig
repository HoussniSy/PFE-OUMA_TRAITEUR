{% extends 'base.html.twig' %}

{% block title %}{{ client.name }} - Ouma Traiteur{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-3">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_client_index') }}">Clients</a></li>
                    <li class="breadcrumb-item active">{{ client.name }}</li>
                </ol>
            </nav>
        </div>
    </div>

    {# Actions #}
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_client_edit', {id: client.id}) }}" class="btn btn-secondary">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
                <a href="{{ path('app_document_new', {type: 'quote'}) }}" class="btn btn-primary">
                    <i class="bi bi-file-earmark-plus"></i> Nouveau devis
                </a>
                <a href="{{ path('app_document_new', {type: 'invoice'}) }}" class="btn btn-success">
                    <i class="bi bi-receipt"></i> Nouvelle facture
                </a>

                {% if is_granted('ROLE_COMPTABLE') and client.documents|length == 0 %}
                    <button type="button" class="btn btn-danger ms-auto" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash"></i> Supprimer
                    </button>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row g-3">
        {# Informations client #}
        <div class="col-12 col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-circle"></i> Informations
                    </h5>
                </div>
                <div class="card-body">
                    <h4 class="mb-3">{{ client.name }}</h4>

                    {% if client.phone %}
                        <p class="mb-2">
                            <i class="bi bi-telephone text-primary"></i>
                            <strong>Téléphone :</strong><br>
                            <a href="tel:{{ client.phone }}" class="text-decoration-none">
                                {{ client.phone }}
                            </a>
                        </p>
                    {% endif %}

                    {% if client.email %}
                        <p class="mb-2">
                            <i class="bi bi-envelope text-info"></i>
                            <strong>Email :</strong><br>
                            <a href="mailto:{{ client.email }}" class="text-decoration-none">
                                {{ client.email }}
                            </a>
                        </p>
                    {% endif %}

                    {% if client.address %}
                        <p class="mb-2">
                            <i class="bi bi-geo-alt text-danger"></i>
                            <strong>Adresse :</strong><br>
                            {{ client.address }}
                        </p>
                    {% endif %}

                    <hr>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Documents :</span>
                        <strong>{{ documents|length }}</strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">CA Total :</span>
                        <strong class="text-success">{{ totalRevenue|number_format(0, ',', ' ') }} MRU</strong>
                    </div>
                </div>
            </div>
        </div>

        {# Historique des documents #}
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> Historique des documents
                    </h5>
                </div>
                <div class="card-body">
                    {% if documents is empty %}
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i><br>
                            Aucun document pour ce client
                        </div>
                    {% else %}
                        {# Version Desktop #}
                        <div class="table-responsive d-none d-md-block">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Numéro</th>
                                        <th>Date</th>
                                        <th class="text-end">Montant</th>
                                        <th>Statut</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for doc in documents %}
                                        <tr>
                                            <td>
                                                <span class="badge {{ doc.type == 'quote' ? 'bg-info' : 'bg-success' }}">
                                                    {{ doc.typeLabel }}
                                                </span>
                                            </td>
                                            <td><strong>{{ doc.number }}</strong></td>
                                            <td>{{ doc.date|date('d/m/Y') }}</td>
                                            <td class="text-end">
                                                <strong>{{ doc.formattedTotalTtc }} MRU</strong>
                                            </td>
                                            <td>
                                                <span class="badge {{ doc.statusBadgeClass }}">
                                                    {{ doc.statusLabel }}
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a href="{{ path('app_document_show', {id: doc.id}) }}"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {# Version Mobile #}
                        <div class="d-md-none">
                            {% for doc in documents %}
                                <div class="card mb-2">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span class="badge {{ doc.type == 'quote' ? 'bg-info' : 'bg-success' }}">
                                                {{ doc.typeLabel }}
                                            </span>
                                            <span class="badge {{ doc.statusBadgeClass }}">
                                                {{ doc.statusLabel }}
                                            </span>
                                        </div>
                                        <h6 class="mb-1">{{ doc.number }}</h6>
                                        <p class="text-muted small mb-1">{{ doc.date|date('d/m/Y') }}</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong class="text-success">{{ doc.formattedTotalTtc }} MRU</strong>
                                            <a href="{{ path('app_document_show', {id: doc.id}) }}"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Voir
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal Suppression #}
{% if is_granted('ROLE_COMPTABLE') %}
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('app_client_delete', {id: client.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Supprimer le client</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer <strong>{{ client.name }}</strong> ?</p>
                    <p class="text-danger"><strong>Cette action est irréversible !</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
