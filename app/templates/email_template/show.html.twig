{% extends 'base.html.twig' %}

{% block title %}{{ template.name }} - Ouma Traiteur{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-envelope-paper"></i> {{ template.name }}
                {% if template.isDefault %}
                    <span class="badge bg-info ms-2">
                        <i class="bi bi-shield-check"></i> Template par défaut
                    </span>
                {% endif %}
            </h1>
            <p class="text-muted">{{ template.categoryLabel }}</p>
        </div>
        <div>
            <a href="{{ path('app_email_template_index') }}" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_email_template_preview', {id: template.id}) }}"
               class="btn btn-outline-primary me-2" target="_blank">
                <i class="bi bi-eye-fill"></i> Prévisualiser
            </a>
            <a href="{{ path('app_email_template_edit', {id: template.id}) }}" class="btn btn-success">
                <i class="bi bi-pencil"></i> Modifier
            </a>
        </div>
    </div>

    <div class="row">
        {# Informations principales #}
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informations</h5>
                    {{ template.categoryBadge|raw }}
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <small class="text-muted">Code</small>
                            <p class="mb-0"><code>{{ template.code }}</code></p>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted">Statut</small>
                            <p class="mb-0">
                                {% if template.isActive %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Actif
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Inactif
                                    </span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted">Type</small>
                            <p class="mb-0">
                                {% if template.isDefault %}
                                    <span class="badge bg-info">Système</span>
                                {% else %}
                                    <span class="badge bg-warning">Personnalisé</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    {% if template.description %}
                        <div class="mb-3">
                            <small class="text-muted">Description</small>
                            <p class="mb-0">{{ template.description }}</p>
                        </div>
                    {% endif %}

                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted">Créé par</small>
                            <p class="mb-0">
                                {% if template.createdBy %}
                                    {{ template.createdBy.fullName }}
                                {% else %}
                                    <em class="text-muted">Système</em>
                                {% endif %}
                                <br>
                                <small class="text-muted">le {{ template.createdAt|date('d/m/Y à H:i') }}</small>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Dernière modification</small>
                            <p class="mb-0">
                                {% if template.updatedBy %}
                                    {{ template.updatedBy.fullName }}
                                {% else %}
                                    <em class="text-muted">Système</em>
                                {% endif %}
                                <br>
                                <small class="text-muted">le {{ template.updatedAt|date('d/m/Y à H:i') }}</small>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-envelope"></i> Sujet de l'email</h5>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded border">{{ template.subject }}</pre>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-code-square"></i> Contenu HTML</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#preview-tab">
                                <i class="bi bi-eye"></i> Aperçu
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#html-tab">
                                <i class="bi bi-code"></i> Code HTML
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content border border-top-0 p-3">
                        <div class="tab-pane fade show active" id="preview-tab">
                            <div class="bg-light p-3 rounded" style="max-height: 500px; overflow-y: auto;">
                                {{ template.body|raw }}
                            </div>
                        </div>
                        <div class="tab-pane fade" id="html-tab">
                            <pre class="bg-dark text-light p-3 rounded" style="max-height: 500px; overflow-y: auto;"><code>{{ template.body }}</code></pre>
                        </div>
                    </div>
                </div>
            </div>

            {# Historique des modifications #}
            {% if history|length > 0 %}
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history"></i> Historique des modifications
                            <span class="badge bg-secondary">{{ history|length }}</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Version</th>
                                        <th>Action</th>
                                        <th>Modifié par</th>
                                        <th>Date</th>
                                        <th>Commentaire</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for entry in history %}
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">v{{ entry.version }}</span>
                                            </td>
                                            <td>{{ entry.actionBadge|raw }}</td>
                                            <td>{{ entry.modifiedBy.fullName }}</td>
                                            <td>
                                                <small class="text-muted">{{ entry.createdAt|date('d/m/Y H:i') }}</small>
                                            </td>
                                            <td>
                                                <small class="text-muted">{{ entry.comment ?? '-' }}</small>
                                            </td>
                                            <td class="text-end">
                                                <form method="post"
                                                      action="{{ path('app_email_template_restore', {id: template.id, version: entry.version}) }}"
                                                      style="display: inline;"
                                                      onsubmit="return confirm('Restaurer cette version ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ template.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Restaurer">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Restaurer
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# Sidebar - Actions et variables #}
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_email_template_edit', {id: template.id}) }}" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Modifier le template
                        </a>

                        <a href="{{ path('app_email_template_preview', {id: template.id}) }}"
                           class="btn btn-outline-secondary" target="_blank">
                            <i class="bi bi-eye-fill"></i> Prévisualiser
                        </a>

                        <form method="post" action="{{ path('app_email_template_duplicate', {id: template.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('duplicate' ~ template.id) }}">
                            <button type="submit" class="btn btn-outline-warning w-100">
                                <i class="bi bi-files"></i> Dupliquer
                            </button>
                        </form>

                        <form method="post" action="{{ path('app_email_template_toggle_status', {id: template.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ template.id) }}">
                            <button type="submit" class="btn btn-outline-info w-100">
                                {% if template.isActive %}
                                    <i class="bi bi-pause-circle"></i> Désactiver
                                {% else %}
                                    <i class="bi bi-play-circle"></i> Activer
                                {% endif %}
                            </button>
                        </form>

                        {% if not template.isDefault %}
                            <hr>
                            <form method="post"
                                  action="{{ path('app_email_template_delete', {id: template.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce template ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ template.id) }}">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-trash"></i> Supprimer
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="bi bi-code-square"></i> Variables disponibles</h6>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    {% for category, data in availableVariables %}
                        <h6 class="mt-3 mb-2">{{ data.label }}</h6>
                        {% for variable, description in data.variables %}
                            <div class="mb-2">
                                <code class="bg-light p-1 rounded">{{ variable }}</code>
                                <br>
                                <small class="text-muted">{{ description }}</small>
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
