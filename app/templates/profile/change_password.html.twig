{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-shield-lock-fill"></i> Changer mon mot de passe</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.currentPassword) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.newPassword.first) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.newPassword.second) }}
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Recommandations :</strong>
                        <ul class="mb-0 mt-2">
                            <li>Minimum 6 caractères</li>
                            <li>Mélangez majuscules, minuscules, chiffres et symboles</li>
                            <li>N'utilisez pas le même mot de passe que d'autres sites</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle-fill"></i> Changer le mot de passe
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            {# Conseils de sécurité #}
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Conseils de sécurité</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Changez votre mot de passe régulièrement</li>
                        <li>Ne partagez jamais votre mot de passe</li>
                        <li>Utilisez un mot de passe unique pour chaque service</li>
                        <li>Activez l'authentification à deux facteurs si disponible</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
