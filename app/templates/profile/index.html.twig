{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            {# Card avec avatar et infos #}
            <div class="card">
                <div class="card-body text-center">
                    <img src="{{ user.avatarPath }}"
                         alt="{{ user.fullName }}"
                         class="rounded-circle mb-3"
                         width="150"
                         height="150"
                         style="object-fit: cover;">

                    <h4>{{ user.fullName }}</h4>

                    {% if user.poste %}
                        <p class="text-muted">{{ user.poste }}</p>
                    {% endif %}

                    <div class="mb-3">
                        {{ user.roleBadge|raw }}
                    </div>

                    {# Supprimer l'avatar #}
                    {% if user.avatar %}
                        <form method="post"
                              action="{{ path('app_profile_delete_avatar') }}"
                              onsubmit="return confirm('Supprimer votre photo de profil ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_avatar') }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Supprimer la photo
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# Informations système #}
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informations</h6>
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tr>
                            <td class="text-muted">Membre depuis</td>
                            <td class="text-end">{{ user.createdAt|date('d/m/Y') }}</td>
                        </tr>
                        {% if user.lastLoginAt %}
                            <tr>
                                <td class="text-muted">Dernière connexion</td>
                                <td class="text-end">{{ user.lastLoginAt|date('d/m/Y H:i') }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <td class="text-muted">Statut</td>
                            <td class="text-end">
                                {% if user.isActive %}
                                    <span class="badge bg-success">Actif</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactif</span>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            {# Changement de mot de passe #}
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-shield-lock"></i> Sécurité</h6>
                </div>
                <div class="card-body">
                    <a href="{{ path('app_profile_change_password') }}" class="btn btn-outline-primary w-100">
                        <i class="bi bi-key-fill"></i> Changer mon mot de passe
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-person-fill"></i> Modifier mon profil</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.nom) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.prenom) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.email) }}
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i> Si vous modifiez votre email, vous devrez vous reconnecter.
                        </small>
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.phone) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.avatarFile) }}
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle-fill"></i>
                        Seuls les administrateurs peuvent modifier votre rôle et le statut de votre compte.
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle-fill"></i> Enregistrer les modifications
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
