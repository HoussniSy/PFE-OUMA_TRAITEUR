{% extends 'base.html.twig' %}

{% block title %}SMS - Détail{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-chat-dots"></i> Détail du SMS</h1>
                <a href="{{ path('app_sms_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Destinataire:</strong><br>
                            {% if smsMessage.client %}
                                <a href="{{ path('app_client_show', {id: smsMessage.client.id}) }}">
                                    {{ smsMessage.recipientName }}
                                </a>
                            {% else %}
                                {{ smsMessage.recipientName ?? '—' }}
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <strong>Téléphone:</strong><br>
                            <code>{{ smsMessage.recipientPhone }}</code>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Statut:</strong><br>
                            <span class="badge {{ smsMessage.statusBadgeClass }}">
                                {{ smsMessage.statusLabel }}
                            </span>
                        </div>
                        <div class="col-md-6">
                            <strong>Date d'envoi:</strong><br>
                            {{ smsMessage.sentAt ? smsMessage.sentAt|date('d/m/Y H:i:s') : '—' }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Créé le:</strong><br>
                            {{ smsMessage.createdAt|date('d/m/Y H:i:s') }}
                        </div>
                        <div class="col-md-6">
                            <strong>ID externe (Twilio):</strong><br>
                            <code>{{ smsMessage.externalId ?? '—' }}</code>
                        </div>
                    </div>

                    {% if smsMessage.segmentCount %}
                    <div class="mb-3">
                        <strong>Segments:</strong> {{ smsMessage.segmentCount }}
                    </div>
                    {% endif %}

                    <hr>

                    <div class="mb-3">
                        <strong>Message:</strong>
                        <div class="p-3 rounded mt-2" style="background-color: #dcf8c6; border-radius: 12px !important;">
                            {{ smsMessage.message|nl2br }}
                        </div>
                    </div>

                    {% if smsMessage.errorMessage %}
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Erreur:</strong> {{ smsMessage.errorMessage }}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
