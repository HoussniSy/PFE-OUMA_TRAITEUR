{% extends 'base.html.twig' %}

{% block title %}SMS - Historique{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-chat-dots"></i> SMS</h1>
        <a href="{{ path('app_sms_send') }}" class="btn btn-ouma-primary">
            <i class="bi bi-send"></i> Envoyer un SMS
        </a>
    </div>

    {# Statistiques #}
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 class="text-primary mb-1">{{ statistics.total }}</h3>
                    <small class="text-muted">Total SMS</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 class="text-success mb-1">{{ statistics.sent + statistics.simulated }}</h3>
                    <small class="text-muted">Envoyés</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 class="text-danger mb-1">{{ statistics.failed }}</h3>
                    <small class="text-muted">Échoués</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 class="text-info mb-1">{{ statistics.this_month }}</h3>
                    <small class="text-muted">Ce mois-ci</small>
                </div>
            </div>
        </div>
    </div>

    {% if not statistics.is_configured %}
    <div class="alert alert-info alert-permanent">
        <i class="bi bi-info-circle"></i>
        <strong>Mode simulation</strong> — Twilio n'est pas configuré. Les SMS sont enregistrés mais non envoyés réellement.
        Configurez <code>TWILIO_ACCOUNT_SID</code>, <code>TWILIO_AUTH_TOKEN</code> et <code>TWILIO_FROM_NUMBER</code> dans le fichier <code>.env.local</code>.
    </div>
    {% endif %}

    {# Filtres #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_sms_index') }}" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Statut</label>
                    <select name="status" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="sent" {{ currentStatus == 'sent' ? 'selected' }}>Envoyé</option>
                        <option value="delivered" {{ currentStatus == 'delivered' ? 'selected' }}>Délivré</option>
                        <option value="failed" {{ currentStatus == 'failed' ? 'selected' }}>Échec</option>
                        <option value="simulated" {{ currentStatus == 'simulated' ? 'selected' }}>Simulé</option>
                        <option value="pending" {{ currentStatus == 'pending' ? 'selected' }}>En attente</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Client</label>
                    <select name="client" class="form-select">
                        <option value="">Tous les clients</option>
                        {% for client in clients %}
                            <option value="{{ client.id }}" {{ currentClient and currentClient.id == client.id ? 'selected' }}>
                                {{ client.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-funnel"></i> Filtrer
                    </button>
                    <a href="{{ path('app_sms_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Réinitialiser
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Tableau des SMS #}
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Destinataire</th>
                        <th>Téléphone</th>
                        <th>Message</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for message in messages %}
                    <tr>
                        <td>
                            <small>{{ message.createdAt|date('d/m/Y H:i') }}</small>
                        </td>
                        <td>
                            {% if message.client %}
                                <a href="{{ path('app_client_show', {id: message.client.id}) }}">
                                    {{ message.recipientName ?? message.client.name }}
                                </a>
                            {% else %}
                                {{ message.recipientName ?? '—' }}
                            {% endif %}
                        </td>
                        <td>
                            <code>{{ message.recipientPhone }}</code>
                        </td>
                        <td>
                            <span title="{{ message.message }}">
                                {{ message.message|length > 60 ? message.message|slice(0, 60) ~ '...' : message.message }}
                            </span>
                        </td>
                        <td>
                            <span class="badge {{ message.statusBadgeClass }}">
                                {{ message.statusLabel }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_sms_show', {id: message.id}) }}" class="btn btn-sm btn-outline-info" title="Détails">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-chat-dots" style="font-size: 2rem;"></i>
                            <p class="mt-2">Aucun SMS envoyé pour le moment.</p>
                            <a href="{{ path('app_sms_send') }}" class="btn btn-sm btn-ouma-primary">
                                <i class="bi bi-send"></i> Envoyer votre premier SMS
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
