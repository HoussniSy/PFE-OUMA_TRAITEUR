{% extends 'base.html.twig' %}

{% block title %}Modifier {{ document.type == 'quote' ? 'devis' : 'facture' }} - Ouma Traiteur{% endblock %}

{% block stylesheets %}
<style>
    .item-row {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        border: 1px solid #dee2e6;
    }
    .item-total {
        background: #e7f5ff;
        padding: 0.5rem;
        border-radius: 5px;
        font-weight: bold;
    }
    .totals-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 10px;
        border: 2px solid #00a651;
    }
    .total-ttc {
        font-size: 1.5rem;
        color: #00a651;
        font-weight: bold;
    }

    @media (max-width: 768px) {
        .item-row {
            padding: 0.75rem;
        }
        .total-ttc {
            font-size: 1.25rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1>
                <i class="bi bi-{{ document.type == 'quote' ? 'file-earmark-text' : 'receipt' }}"></i>
                Modifier {{ document.type == 'quote' ? 'devis' : 'facture' }}
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_document_index') }}">Documents</a></li>
                    <li class="breadcrumb-item active">Modifier</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {# Informations générales #}
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Type</label>
                        <input type="text" class="form-control"
                               value="{{ document.type == 'quote' ? 'Devis' : 'Facture' }}" disabled>
                    </div>

                    <div class="col-md-6">
                        {{ form_row(form.number) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_row(form.date, {
                            'label': 'Date',
                            'attr': {'class': 'form-control'}
                        }) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_row(form.client, {
                            'label': 'Client',
                            'attr': {'class': 'form-select'}
                        }) }}
                    </div>

                    <div class="col-md-4">
                        {{ form_row(form.location, {
                            'label': 'Lieu',
                            'attr': {'class': 'form-control', 'placeholder': 'Nouakchott'}
                        }) }}
                    </div>
                </div>

                {# Prestations #}
                <div class="mb-4">
                    <h5 class="mb-3">
                        <i class="bi bi-list-ul"></i> Prestations
                    </h5>

                    <div id="items-container" data-prototype="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}" data-index="{{ form.items|length }}">
                        {% for item in form.items %}
                            <div class="item-row" data-item-index="{{ loop.index0 }}">
                                <div class="row g-2">
                                    <div class="col-12">
                                        {{ form_row(item.designation, {
                                            'label': 'Désignation',
                                            'attr': {'class': 'form-control', 'placeholder': 'Ex: Pause café matin'}
                                        }) }}
                                    </div>

                                    <div class="col-6 col-md-2">
                                        {{ form_row(item.numberOfDays, {
                                            'label': 'Nb jours',
                                            'attr': {'class': 'form-control item-field', 'min': 1}
                                        }) }}
                                    </div>

                                    <div class="col-6 col-md-2">
                                        {{ form_row(item.numberOfPersons, {
                                            'label': 'Nb pers.',
                                            'attr': {'class': 'form-control item-field', 'min': 1}
                                        }) }}
                                    </div>

                                    <div class="col-6 col-md-2">
                                        {{ form_row(item.numberOfServices, {
                                            'label': 'Nb serv.',
                                            'attr': {'class': 'form-control item-field', 'min': 1, 'value': 1}
                                        }) }}
                                    </div>

                                    <div class="col-6 col-md-3">
                                        {{ form_row(item.unitPrice, {
                                            'label': 'Prix unit.',
                                            'attr': {'class': 'form-control item-field', 'min': 0, 'step': 0.01}
                                        }) }}
                                    </div>

                                    <div class="col-12 col-md-3">
                                        <label class="form-label">Total ligne</label>
                                        <div class="item-total">
                                            <span class="item-total-value">0</span> MRU
                                        </div>
                                    </div>
                                </div>

                                <div class="text-end mt-2">
                                    <button type="button" class="btn btn-sm btn-danger remove-item">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" id="add-item" class="btn btn-outline-success mt-2">
                        <i class="bi bi-plus-circle"></i> Ajouter une ligne
                    </button>
                </div>

                {# Totaux #}
                <div class="totals-section">
                    <div class="row g-3">
                        <div class="col-md-4 ms-auto">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total HT :</span>
                                <strong><span id="total-ht">0</span> MRU</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>TVA 16% :</span>
                                <strong><span id="total-tva">0</span> MRU</strong>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <span class="h5">Total TTC :</span>
                                <span class="total-ttc" id="total-ttc">0 MRU</span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Boutons #}
                <div class="mt-4 d-flex gap-2 justify-content-end">
                    <a href="{{ path('app_document_index') }}" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-ouma-primary">
                        <i class="bi bi-save"></i> Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('items-container');
    const addButton = document.getElementById('add-item');
    let index = parseInt(container.dataset.index);

    console.log('JavaScript chargé, index initial:', index);

    // Ajouter une ligne
    addButton.addEventListener('click', function(e) {
        e.preventDefault();
        console.log('Bouton "Ajouter une ligne" cliqué, index actuel:', index);

        const prototype = container.dataset.prototype;
        console.log('Prototype récupéré');

        // Remplacer __name__ par l'index actuel
        const newForm = prototype.replace(/__name__/g, index);
        console.log('Nouveau formulaire généré pour index:', index);

        // Créer le wrapper de la ligne
        const div = document.createElement('div');
        div.classList.add('item-row');
        div.dataset.itemIndex = index;

        // Parser le HTML et restructurer correctement
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = newForm;

        // Créer la structure avec row g-2
        const rowDiv = document.createElement('div');
        rowDiv.classList.add('row', 'g-2');

        // Récupérer tous les champs du formulaire
        const formGroups = tempDiv.querySelectorAll('.mb-3');

        // Désignation (col-12)
        if (formGroups[0]) {
            const col = document.createElement('div');
            col.classList.add('col-12');
            col.appendChild(formGroups[0]);
            rowDiv.appendChild(col);
        }

        // numberOfDays (col-6 col-md-2)
        if (formGroups[1]) {
            const col = document.createElement('div');
            col.classList.add('col-6', 'col-md-2');
            const input = formGroups[1].querySelector('input');
            if (input) {
                input.classList.add('item-field');
                input.setAttribute('min', '1');
            }
            col.appendChild(formGroups[1]);
            rowDiv.appendChild(col);
        }

        // numberOfPersons (col-6 col-md-2)
        if (formGroups[2]) {
            const col = document.createElement('div');
            col.classList.add('col-6', 'col-md-2');
            const input = formGroups[2].querySelector('input');
            if (input) {
                input.classList.add('item-field');
                input.setAttribute('min', '1');
            }
            col.appendChild(formGroups[2]);
            rowDiv.appendChild(col);
        }

        // numberOfServices (col-6 col-md-2)
        if (formGroups[3]) {
            const col = document.createElement('div');
            col.classList.add('col-6', 'col-md-2');
            const input = formGroups[3].querySelector('input');
            if (input) {
                input.classList.add('item-field');
                input.setAttribute('min', '1');
                input.value = '1';
            }
            col.appendChild(formGroups[3]);
            rowDiv.appendChild(col);
        }

        // unitPrice (col-6 col-md-3)
        if (formGroups[4]) {
            const col = document.createElement('div');
            col.classList.add('col-6', 'col-md-3');
            const input = formGroups[4].querySelector('input');
            if (input) {
                input.classList.add('item-field');
                input.setAttribute('min', '0');
                input.setAttribute('step', '0.01');
            }
            col.appendChild(formGroups[4]);
            rowDiv.appendChild(col);
        }

        // Total ligne (col-12 col-md-3)
        const totalCol = document.createElement('div');
        totalCol.classList.add('col-12', 'col-md-3');
        totalCol.innerHTML = `
            <label class="form-label">Total ligne</label>
            <div class="item-total">
                <span class="item-total-value">0</span> MRU
            </div>
        `;
        rowDiv.appendChild(totalCol);

        // Ajouter la row au div principal
        div.appendChild(rowDiv);

        // Ajouter le bouton supprimer
        const deleteDiv = document.createElement('div');
        deleteDiv.classList.add('text-end', 'mt-2');
        deleteDiv.innerHTML = `
            <button type="button" class="btn btn-sm btn-danger remove-item">
                <i class="bi bi-trash"></i> Supprimer
            </button>
        `;
        div.appendChild(deleteDiv);

        // Ajouter au container
        container.appendChild(div);
        console.log('Nouvelle ligne ajoutée au container');

        // Incrémenter l'index
        index++;
        container.dataset.index = index;

        // Attacher les événements
        attachEventListeners(div);
        console.log('Événements attachés à la nouvelle ligne');

        // Recalculer les totaux
        calculateTotals();
    });

    // Supprimer une ligne
    container.addEventListener('click', function(e) {
        if (e.target.closest('.remove-item')) {
            e.preventDefault();
            const row = e.target.closest('.item-row');
            console.log('Suppression de la ligne:', row.dataset.itemIndex);
            row.remove();
            calculateTotals();
        }
    });

    // Calcul automatique
    function attachEventListeners(row) {
        const fields = row.querySelectorAll('.item-field');
        fields.forEach(field => {
            field.addEventListener('input', function() {
                calculateItemTotal(row);
                calculateTotals();
            });
        });
    }

    function calculateItemTotal(row) {
        const days = parseFloat(row.querySelector('[name*="numberOfDays"]')?.value) || 0;
        const persons = parseFloat(row.querySelector('[name*="numberOfPersons"]')?.value) || 0;
        const services = parseFloat(row.querySelector('[name*="numberOfServices"]')?.value) || 1;
        const price = parseFloat(row.querySelector('[name*="unitPrice"]')?.value) || 0;

        const total = days * persons * services * price;
        const totalElement = row.querySelector('.item-total-value');
        if (totalElement) {
            totalElement.textContent = total.toLocaleString('fr-FR', {minimumFractionDigits: 0, maximumFractionDigits: 0});
        }
    }

    function calculateTotals() {
        let totalHT = 0;
        document.querySelectorAll('.item-row').forEach(row => {
            const days = parseFloat(row.querySelector('[name*="numberOfDays"]')?.value) || 0;
            const persons = parseFloat(row.querySelector('[name*="numberOfPersons"]')?.value) || 0;
            const services = parseFloat(row.querySelector('[name*="numberOfServices"]')?.value) || 1;
            const price = parseFloat(row.querySelector('[name*="unitPrice"]')?.value) || 0;
            totalHT += days * persons * services * price;
        });

        const totalTVA = totalHT * 0.16;
        const totalTTC = totalHT + totalTVA;

        document.getElementById('total-ht').textContent = totalHT.toLocaleString('fr-FR', {minimumFractionDigits: 0, maximumFractionDigits: 0});
        document.getElementById('total-tva').textContent = totalTVA.toLocaleString('fr-FR', {minimumFractionDigits: 0, maximumFractionDigits: 0});
        document.getElementById('total-ttc').textContent = totalTTC.toLocaleString('fr-FR', {minimumFractionDigits: 0, maximumFractionDigits: 0}) + ' MRU';
    }

    // Initialiser les listeners sur les lignes existantes
    document.querySelectorAll('.item-row').forEach(row => {
        attachEventListeners(row);
        calculateItemTotal(row);
    });

    calculateTotals();
    console.log('Initialisation terminée');
});
</script>
{% endblock %}
