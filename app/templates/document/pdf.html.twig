<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ document.typeLabel }} {{ document.number }}</title>
    <style>
        @page {
            margin: 20mm 15mm;
        }

        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.4;
            color: #333;
        }

        .header {
            border-bottom: 3px solid {{ primaryColor }};
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .header-left {
            width: 60%;
            float: left;
        }

        .header-right {
            width: 38%;
            float: right;
            text-align: right;
        }

        .logo {
            max-height: 60px;
            margin-bottom: 10px;
        }

        .company-name {
            font-size: 18pt;
            font-weight: bold;
            color: {{ primaryColor }};
            margin: 0;
        }

        .company-name-ar {
            font-size: 14pt;
            font-weight: bold;
            color: {{ primaryColor }};
            direction: rtl;
            text-align: right;
            margin: 5px 0;
        }

        .company-info {
            font-size: 9pt;
            color: #666;
            margin-top: 5px;
        }

        .document-type {
            font-size: 24pt;
            font-weight: bold;
            color: {{ primaryColor }};
            margin: 0;
        }

        .document-number {
            font-size: 16pt;
            font-weight: bold;
            margin: 5px 0;
        }

        .document-date {
            font-size: 9pt;
            color: #666;
        }

        .clearfix::after {
            content: "";
            display: table;
            clear: both;
        }

        .client-section {
            margin: 20px 0;
        }

        .client-label {
            font-weight: bold;
            font-size: 11pt;
            margin-bottom: 5px;
        }

        .client-name {
            font-size: 12pt;
            font-weight: bold;
            margin: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        table th {
            background-color: #f0f0f0;
            border: 1px solid #333;
            padding: 8px;
            text-align: left;
            font-weight: bold;
            font-size: 9pt;
        }

        table td {
            border: 1px solid #333;
            padding: 8px;
            font-size: 9pt;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .totals-row td {
            border-top: 2px solid #333;
            font-weight: bold;
        }

        .total-ttc-row {
            background-color: {{ lightColor }};
        }

        .total-ttc-row td {
            font-size: 11pt;
            font-weight: bold;
            color: {{ primaryColor }};
        }

        .bank-info {
            background-color: #f5f5f5;
            border: 1px solid #ddd;
            padding: 10px;
            margin: 20px 0;
            font-size: 9pt;
        }

        .bank-account-highlight {
            background-color: {{ primaryColor }};
            color: white;
            padding: 2px 5px;
            font-weight: bold;
        }

        .amount-words {
            font-style: italic;
            color: #666;
            margin: 10px 0;
            font-size: 9pt;
        }

        .signature-section {
            margin-top: 40px;
            text-align: right;
        }

        .signature-line {
            margin-top: 50px;
            font-weight: bold;
        }

        /* Watermark style */
        .watermark {
            position: fixed;
            top: 35%;
            left: 15%;
            font-size: 100pt;
            font-weight: bold;
            color: rgba(0, 0, 0, 0.06);
            transform: rotate(-35deg);
            z-index: -1;
            pointer-events: none;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    {# Watermark pour les devis si activé #}
    {% if showWatermark is defined and showWatermark %}
        <div class="watermark">DEVIS</div>
    {% endif %}

    {# En-tête #}
    <div class="header clearfix">
        <div class="header-left">
            {% if documentLogo %}
                <img src="{{ asset('uploads/logos/' ~ documentLogo) }}" alt="Logo" class="logo">
            {% elseif company and company.logo %}
                <img src="{{ asset('uploads/logos/' ~ company.logo) }}" alt="Logo" class="logo">
            {% endif %}
            <p class="company-name">{{ company.name }}</p>
            <p class="company-name-ar">{{ company.nameArabic }}</p>
            <div class="company-info">
                Numéro Registre : {{ company.registrationNumber }}<br>
                NIF : {{ company.nif }}<br>
                TEL : {{ company.phone }}
            </div>
        </div>

        <div class="header-right">
            <p class="document-date">
                {{ document.location }}, {{ document.date|date('d/m/Y') }}
            </p>
            <p class="document-type">{{ document.typeLabel }}</p>
            <p class="document-number">N° {{ document.number }}</p>
        </div>
    </div>

    {# Client #}
    <div class="client-section">
        <div class="client-label">Client :</div>
        <p class="client-name">{{ document.client.name }}</p>
    </div>

    {# Tableau des prestations #}
    <table>
        <thead>
            <tr>
                <th style="width: 35%;">Désignation</th>
                <th class="text-center" style="width: 10%;">Nbr de Jour</th>
                <th class="text-center" style="width: 10%;">Nbr de Personne</th>
                <th class="text-center" style="width: 10%;">Nbr de Service</th>
                <th class="text-right" style="width: 15%;">Prix Unitaire</th>
                <th class="text-right" style="width: 20%;">Montant Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in document.items %}
                <tr>
                    <td>{{ item.designation }}</td>
                    <td class="text-center">{{ item.numberOfDays }}</td>
                    <td class="text-center">{{ item.numberOfPersons }}</td>
                    <td class="text-center">{{ item.numberOfServices }}</td>
                    <td class="text-right">{{ item.formattedUnitPrice }}</td>
                    <td class="text-right">{{ item.formattedTotalAmount }}</td>
                </tr>
            {% endfor %}

            {# Totaux #}
            <tr class="totals-row">
                <td colspan="5" class="text-right">TOTAL HT</td>
                <td class="text-right">{{ document.totalHt|number_format(0, ',', ' ') }}</td>
            </tr>
            <tr>
                <td colspan="5" class="text-right">TVA 16%</td>
                <td class="text-right">{{ (document.totalHt * 0.16)|number_format(0, ',', ' ') }}</td>
            </tr>
            <tr class="total-ttc-row">
                <td colspan="5" class="text-right">TOTAL</td>
                <td class="text-right">{{ document.formattedTotalTtc }} MRU</td>
            </tr>
        </tbody>
    </table>

    {# Montant en lettres #}
    {% if totalInWords is defined %}
        <p class="amount-words">
            La présente facture est arrêtée à la somme de :
            <strong>{{ totalInWords }}</strong>
        </p>
    {% endif %}

    {# Informations bancaires #}
    <div class="bank-info">
        Numéro compte bancaire :
        <span class="bank-account-highlight">{{ company.bankName }} – {{ company.bankAccount }}</span>
    </div>

    {# Signature #}
    <div class="signature-section">
        <p><strong>LE GERANT</strong></p>
        <div class="signature-line"></div>
    </div>

    {# Pied de page avec informations #}
    <div style="position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 8pt; color: #999; border-top: 1px solid #ddd; padding-top: 10px;">
        {{ company.name }} - {{ company.phone }} - {{ company.address }}
    </div>

</body>
</html>
