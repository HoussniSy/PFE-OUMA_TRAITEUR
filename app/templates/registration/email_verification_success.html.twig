{% extends 'base.html.twig' %}

{% block title %}Vérification réussie{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #4A90E2;"></i>
                        </div>
                        <h1 class="h3 mb-3">Votre adresse email a été vérifiée avec succès !</h1>
                        <p>Vous pouvez maintenant vous connecter à votre compte.</p>
                        <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
