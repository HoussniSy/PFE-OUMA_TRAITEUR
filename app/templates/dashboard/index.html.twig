{% extends 'base.html.twig' %}

{% block title %}Dashboard - Ouma Traiteur{% endblock %}

{% block stylesheets %}
<style>
    .stat-card {
        border-left: 4px solid;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 24px rgba(74, 144, 226, 0.15) !important;
    }
    .stat-card .icon {
        font-size: 2.5rem;
        opacity: 0.8;
    }
    .badge-status {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }

    /* Drag & Drop styles */
    .widget-editable {
        cursor: grab;
        border: 2px dashed transparent;
        transition: border-color 0.2s, opacity 0.2s;
    }
    .widget-editable:hover {
        border-color: var(--ouma-primary, #4A90E2);
    }
    .widget-dragging {
        opacity: 0.4;
        cursor: grabbing;
    }
    .widget-drag-over {
        border-color: var(--ouma-primary, #4A90E2) !important;
        background-color: rgba(74, 144, 226, 0.05);
    }
    .widget-hidden {
        display: none;
    }

    .dashboard-editing .widget-container {
        position: relative;
    }
    .dashboard-editing .widget-container::before {
        content: '\f3f2';
        font-family: 'bootstrap-icons';
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 10;
        background: linear-gradient(135deg, #4A90E2, #6C5CE7);
        color: white;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .edit-panel {
        border: 1px solid rgba(74, 144, 226, 0.3);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(74, 144, 226, 0.06), rgba(108, 92, 231, 0.03));
    }

    @media (max-width: 768px) {
        .stat-card .icon {
            font-size: 2rem;
        }
        h1 {
            font-size: 1.5rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container" data-controller="dashboard">
    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-speedometer2"></i> Tableau de bord</h1>
                <p class="text-muted">Bienvenue, {{ app.user.fullName }}</p>
            </div>
            <div>
                <button class="btn btn-outline-secondary" data-action="click->dashboard#toggleEdit">
                    <i class="bi bi-gear"></i> Personnaliser
                </button>
            </div>
        </div>
    </div>

    {# Panneau de personnalisation (caché par défaut) #}
    <div class="row mb-4" data-dashboard-target="editPanel" style="display: none;">
        <div class="col-12">
            <div class="card edit-panel">
                <div class="card-body">
                    <h5 class="card-title mb-3">
                        <i class="bi bi-sliders"></i> Personnaliser le tableau de bord
                    </h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle"></i>
                        Glissez-déposez les widgets pour réorganiser. Utilisez les cases à cocher pour afficher/masquer.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        {% for widget in widgets %}
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="toggle_{{ widget.widgetType }}"
                                       data-widget-type="{{ widget.widgetType }}"
                                       data-action="change->dashboard#toggleWidget"
                                       {{ widget.visible ? 'checked' : '' }}>
                                <label class="form-check-label" for="toggle_{{ widget.widgetType }}">
                                    <i class="bi {{ widget.icon }}"></i> {{ widget.label }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Widgets Container #}
    <div id="widgets-container">
        {% for widget in widgets %}
            {# Widget: Statistiques #}
            {% if widget.widgetType == 'stats' %}
                <div class="widget-container mb-4 {{ not widget.visible ? 'widget-hidden' }}"
                     data-dashboard-target="widget"
                     data-widget-type="stats"
                     draggable="false">
                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card stat-card border-primary">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="text-muted mb-1 small">Total Clients</p>
                                            <h3 class="mb-0">{{ totalClients }}</h3>
                                        </div>
                                        <div class="icon text-primary">
                                            <i class="bi bi-people"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card stat-card border-info">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="text-muted mb-1 small">Devis</p>
                                            <h3 class="mb-0">{{ totalQuotes }}</h3>
                                        </div>
                                        <div class="icon text-info">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card stat-card border-success">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="text-muted mb-1 small">Factures</p>
                                            <h3 class="mb-0">{{ totalInvoices }}</h3>
                                        </div>
                                        <div class="icon text-success">
                                            <i class="bi bi-receipt"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="card stat-card border-warning">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="text-muted mb-1 small">CA du mois</p>
                                            <h3 class="mb-0">{{ monthlyRevenue|number_format(0, ',', ' ') }}</h3>
                                            <small class="text-muted">MRU</small>
                                        </div>
                                        <div class="icon text-warning">
                                            <i class="bi bi-currency-exchange"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            {# Widget: Actions rapides #}
            {% elseif widget.widgetType == 'quick_actions' %}
                <div class="widget-container mb-4 {{ not widget.visible ? 'widget-hidden' }}"
                     data-dashboard-target="widget"
                     data-widget-type="quick_actions"
                     draggable="false">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-lightning-charge"></i> Actions rapides
                            </h5>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="{{ path('app_document_new', {type: 'quote'}) }}" class="btn btn-outline-primary">
                                    <i class="bi bi-file-earmark-plus"></i> Nouveau devis
                                </a>
                                <a href="{{ path('app_document_new', {type: 'invoice'}) }}" class="btn btn-outline-success">
                                    <i class="bi bi-receipt"></i> Nouvelle facture
                                </a>
                                <a href="{{ path('app_client_new') }}" class="btn btn-outline-info">
                                    <i class="bi bi-person-plus"></i> Nouveau client
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            {# Widget: Graphique CA #}
            {% elseif widget.widgetType == 'revenue_chart' %}
                <div class="widget-container mb-4 {{ not widget.visible ? 'widget-hidden' }}"
                     data-dashboard-target="widget"
                     data-widget-type="revenue_chart"
                     draggable="false">
                    <div class="row g-3">
                        <div class="col-12 col-lg-8">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="bi bi-graph-up"></i> Chiffre d'affaires - 6 derniers mois
                                    </h5>
                                    <canvas id="revenueChart" style="max-height: 300px;"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            {# Petit résumé à droite du graphique #}
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column justify-content-center text-center">
                                    <h6 class="text-muted mb-3">Résumé annuel</h6>
                                    <div class="mb-3">
                                        <span class="text-muted small d-block">Total factures</span>
                                        <h4 class="text-success mb-0">{{ totalInvoices }}</h4>
                                    </div>
                                    <div>
                                        <span class="text-muted small d-block">Total devis</span>
                                        <h4 class="text-info mb-0">{{ totalQuotes }}</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            {# Widget: Devis en attente #}
            {% elseif widget.widgetType == 'pending_quotes' %}
                <div class="widget-container mb-4 {{ not widget.visible ? 'widget-hidden' }}"
                     data-dashboard-target="widget"
                     data-widget-type="pending_quotes"
                     draggable="false">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-clock-history"></i> Devis en attente
                                <span class="badge bg-warning">{{ pendingQuotes|length }}</span>
                            </h5>

                            {% if pendingQuotes is empty %}
                                <p class="text-muted text-center py-4">
                                    <i class="bi bi-check-circle" style="font-size: 2rem;"></i><br>
                                    Aucun devis en attente
                                </p>
                            {% else %}
                                <div class="list-group list-group-flush">
                                    {% for quote in pendingQuotes %}
                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1">{{ quote.number }}</h6>
                                                    <small class="text-muted">
                                                        <i class="bi bi-person"></i> {{ quote.client.name }}
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <a href="{{ path('app_document_show', {id: quote.id}) }}"
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            {# Widget: Documents récents #}
            {% elseif widget.widgetType == 'recent_documents' %}
                <div class="widget-container mb-4 {{ not widget.visible ? 'widget-hidden' }}"
                     data-dashboard-target="widget"
                     data-widget-type="recent_documents"
                     draggable="false">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-clock"></i> Documents récents
                            </h5>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Type</th>
                                            <th>Numéro</th>
                                            <th>Client</th>
                                            <th>Date</th>
                                            <th class="text-end">Montant TTC</th>
                                            <th>Statut</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for doc in recentDocuments %}
                                            <tr>
                                                <td>
                                                    <span class="badge {{ doc.type == 'quote' ? 'bg-info' : 'bg-success' }}">
                                                        {{ doc.typeLabel }}
                                                    </span>
                                                </td>
                                                <td><strong>{{ doc.number }}</strong></td>
                                                <td>{{ doc.client.name }}</td>
                                                <td>{{ doc.date|date('d/m/Y') }}</td>
                                                <td class="text-end">
                                                    <strong>{{ doc.formattedTotalTtc }} MRU</strong>
                                                </td>
                                                <td>
                                                    <span class="badge badge-status {{ doc.statusBadgeClass }}">
                                                        {{ doc.statusLabel }}
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <a href="{{ path('app_document_show', {id: doc.id}) }}"
                                                       class="btn btn-sm btn-outline-primary"
                                                       title="Voir">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="7" class="text-center text-muted py-4">
                                                    <i class="bi bi-inbox" style="font-size: 2rem;"></i><br>
                                                    Aucun document récent
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {% if recentDocuments|length == 10 %}
                                <div class="text-center mt-3">
                                    <a href="{{ path('app_document_index') }}" class="btn btn-outline-secondary">
                                        Voir tous les documents <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Données du graphique
    const monthlyData = {{ monthlyData|json_encode|raw }};

    // Configuration du graphique
    const ctx = document.getElementById('revenueChart');
    if (ctx) {
        new Chart(ctx.getContext('2d'), {
            type: 'line',
            data: {
                labels: monthlyData.map(d => d.month),
                datasets: [{
                    label: 'Chiffre d\'affaires (MRU)',
                    data: monthlyData.map(d => d.revenue),
                    borderColor: '#4A90E2',
                    backgroundColor: 'rgba(74, 144, 226, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#4A90E2',
                    pointBorderColor: '#4A90E2',
                    pointHoverBackgroundColor: '#FF6F61',
                    pointHoverBorderColor: '#FF6F61',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y.toLocaleString('fr-FR') + ' MRU';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('fr-FR');
                            }
                        }
                    }
                }
            }
        });
    }
</script>
{% endblock %}
