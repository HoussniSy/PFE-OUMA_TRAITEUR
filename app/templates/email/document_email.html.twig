<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if document.type == 'quote' %}Devis{% else %}Facture{% endif %} {{ document.number }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #00a651; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0; }
        .header h1 { margin: 0; font-size: 24px; }
        .content { background-color: #ffffff; padding: 30px; border: 1px solid #ddd; border-top: none; }
        .badge { display: inline-block; padding: 5px 15px; border-radius: 20px; font-size: 14px; font-weight: bold; }
        .badge-quote { background-color: #0066cc; color: white; }
        .badge-invoice { background-color: #00a651; color: white; }
        .info-table { width: 100%; margin: 20px 0; border-collapse: collapse; }
        .info-table td { padding: 10px; border: 1px solid #ddd; }
        .info-table td:first-child { background-color: #f5f5f5; font-weight: bold; width: 40%; }
        .total { background-color: #e6f9f0; padding: 15px; border-radius: 5px; margin: 20px 0; text-align: center; }
        .total-amount { font-size: 28px; color: #00a651; font-weight: bold; }
        .message-box { background-color: #f9f9f9; padding: 15px; border-left: 4px solid #00a651; margin: 20px 0; }
        .footer { background-color: #f5f5f5; padding: 20px; text-align: center; font-size: 12px; color: #666; border-radius: 0 0 8px 8px; }
        .footer p { margin: 5px 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{ company.name }}</h1>
            {% if company.nameArabic %}
                <p style="font-size: 16px; margin: 5px 0; direction: rtl;">{{ company.nameArabic }}</p>
            {% endif %}
        </div>

        <div class="content">
            <p>Bonjour,</p>
            <p>Veuillez trouver ci-joint {% if document.type == 'quote' %}votre devis{% else %}votre facture{% endif %} <strong>{{ document.number }}</strong>.</p>

            {% if message %}
                <div class="message-box">
                    {{ message|nl2br }}
                </div>
            {% endif %}

            <table class="info-table">
                <tr>
                    <td>Type</td>
                    <td>
                        <span class="badge {% if document.type == 'quote' %}badge-quote{% else %}badge-invoice{% endif %}">
                            {% if document.type == 'quote' %}Devis{% else %}Facture{% endif %}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td>Numéro</td>
                    <td><strong>{{ document.number }}</strong></td>
                </tr>
                <tr>
                    <td>Date</td>
                    <td>{{ document.date|date('d/m/Y') }}</td>
                </tr>
                {% if document.location %}
                    <tr>
                        <td>Lieu</td>
                        <td>{{ document.location }}</td>
                    </tr>
                {% endif %}
            </table>

            <div class="total">
                <p style="margin: 0 0 10px 0; font-size: 14px; color: #666;">Montant total</p>
                <div class="total-amount">{{ document.totalTtc|number_format(0, ',', ' ') }} {{ document.currency }}</div>
            </div>

            {% if document.type == 'invoice' %}
                <p style="background-color: #fff3cd; padding: 10px; border-radius: 5px; border-left: 4px solid #ffc107;">
                    <strong>⚠️ Paiement :</strong> Merci de procéder au règlement dans les meilleurs délais.
                </p>
            {% endif %}

            <p style="margin-top: 30px;">Cordialement,<br><strong>{{ company.name }}</strong></p>
        </div>

        <div class="footer">
            <p><strong>{{ company.name }}</strong></p>
            <p>📞 {{ company.phone }}</p>
            {% if company.address %}
                <p>📍 {{ company.address }}</p>
            {% endif %}
            <hr style="border: none; border-top: 1px solid #ddd; margin: 15px 0;">
            <p>Cet email a été généré automatiquement. Merci de ne pas y répondre.</p>
        </div>
    </div>
</body>
</html>
